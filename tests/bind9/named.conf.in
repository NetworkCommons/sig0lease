// Template for the local BIND 9 CI gate (plan S14 Option C). lib/bind9.sh's start_bind9
// copies this into a scratch runtime directory, substituting @RUNDIR@, before starting
// named -- so the source tree's own copy (and the zone file template next to it) never
// gets rewritten by BIND's own dynamic-update journal/zone-dump machinery.
options {
    directory "@RUNDIR@";
    listen-on port 5300 { 127.0.0.1; };
    listen-on-v6 { none; };
    recursion no;
    dnssec-validation no;
    allow-query { any; };
    allow-transfer { none; };
    pid-file "@RUNDIR@/named.pid";
    // How many SIG(0) signatures named verifies at once before REFUSING further SIG(0)
    // requests (BIND 9.20's default is 1). lib/bind9.sh sets it from BIND9_SIG0_QUOTA, and
    // the suites give the proxy the same authoritative.max_inflight_updates.
    sig0checks-quota @SIG0_QUOTA@;
};

// "severity dynamic" logs at named's own debug level, which lib/bind9.sh starts at 1 (-d 1):
// the level at which BIND logs why it refused a SIG(0)-signed request under its concurrency
// quota ("client: debug 1: ... SIG(0) checks quota reached" -- sig0checks-quota defaults to
// 1, so a second SIG(0) request arriving while one is being verified is refused, not
// queued). At the default info level such a REFUSED update leaves no trace in the log at
// all. print-category/print-severity make each line's source explicit for
// bind9_report_rejections.
logging {
    channel test_log {
        file "@RUNDIR@/named.log" versions 1 size 50m;
        severity dynamic;
        print-time yes;
        print-category yes;
        print-severity yes;
    };
    category default { test_log; };
    category update { test_log; };
    category update-security { test_log; };
    category security { test_log; };
};

// SIG(0) dynamic-update authorization: srp.test.'s own apex KEY (published in the zone
// file below) is granted update rights over the whole zone -- the same self-signing model
// already proven against the real dev.zenr.io. zone at ns1.free2air.org (the proxy's own
// keystore key, owned at the zone apex it updates).
zone "srp.test." {
    type primary;
    file "@RUNDIR@/srp.test.zone";
    update-policy {
        grant srp.test. zonesub ANY;
    };
};

// update.test. -- the RFC 9664 handler's zone in tests/test_update.sh's local mode
// (AUTH_BACKEND=local). Same self-signing model, its own apex key
// (tests/keystore-update-bind9/), so the update handler and srp_handler, which that mode also
// runs on srp.test., each have their own zone and key.
zone "update.test." {
    type primary;
    file "@RUNDIR@/update.test.zone";
    update-policy {
        grant update.test. zonesub ANY;
    };
};

// default.service.arpa. -- tests/test_mdnsresponder_interop.sh's zone. Same self-signing
// model, different apex key (tests/keystore-srp-bind9-default-arpa/): this name is forced
// by mDNSResponder's own hardcoded client-side zone string, not a free choice (see
// default.service.arpa.zone.in's own doc comment). Served by the same named instance/port
// as srp.test. -- BIND routes purely by zone name, so one process/port covers both.
zone "default.service.arpa." {
    type primary;
    file "@RUNDIR@/default.service.arpa.zone";
    update-policy {
        grant default.service.arpa. zonesub ANY;
    };
};
