diff --git a/ServiceRegistration/Makefile b/ServiceRegistration/Makefile
index 517fe80..96007f1 100644
--- a/ServiceRegistration/Makefile
+++ b/ServiceRegistration/Makefile
@@ -35,8 +35,24 @@ VERIFYOBJS   = $(OBJDIR)/verify-macos.o
 TLSOBJS      = $(OBJDIR)/tls-macos.o
 IOOBJS       = $(OBJDIR)/ioloop.o $(OBJDIR)/posix.o $(OBJDIR)/ioloop-common.o
 IOWOTLSOBJS  = $(OBJDIR)/ioloop.o $(OBJDIR)/posix.o
+else ifeq ($(os), x-mbedtls)
+# macOS as for os=x, but with mbedtls 3 (Homebrew's: brew install mbedtls@3) in place of the Security framework, so
+# that srp-client keeps its key in a file in its working directory, as on Linux, rather than in one login-keychain
+# item that every run shares. -DSRP_FEATURE_REPLICATION=0 as for linux below. Local build patch, see
+# main/tests/README.md (mDNSResponder section).
+MBEDTLS_PREFIX ?= $(shell brew --prefix mbedtls@3)
+SRPCFLAGS = -O0 -g -Wall -Werror -I../mDNSCore -I$(MBEDTLS_PREFIX)/include -I. -I../mDNSMacOSX/Private $(INCLUDEDIRS) -I../DSO -MMD -MF .depfile-${notdir $@} -DUSE_KQUEUE -DHAVE_SOCKADDR_DL -DGENKEY_PROGRAM=$(GENKEY) -DCERTWRITE_PROGRAM=$(CERTWRITE) -DEXCLUDE_TLS -DPOSIX_BUILD -D__APPLE_USE_RFC_3542 -DSTANDALONE -DMDNS_NO_STRICT=1 -DSRP_CRYPTO_MBEDTLS -DSRP_FEATURE_REPLICATION=0
+SRPLDOPTS = -L$(MBEDTLS_PREFIX)/lib -lmbedcrypto -lmbedtls -lmbedx509 -framework CoreServices -framework Security -framework CoreFoundation -framework Network
+HMACOBJS     = $(OBJDIR)/hmac-mbedtls.o
+SIGNOBJS     = $(OBJDIR)/sign-mbedtls.o $(OBJDIR)/srp-filedata.o
+VERIFYOBJS   = $(OBJDIR)/verify-mbedtls.o
+IOOBJS       = $(OBJDIR)/ioloop.o $(OBJDIR)/posix.o $(OBJDIR)/ioloop-common.o
+IOWOTLSOBJS  = $(OBJDIR)/ioloop.o $(OBJDIR)/posix.o
 else ifeq ($(os), linux)
-SRPCFLAGS = -DMDNS_UDS_SERVERPATH=\"/var/run/mdnsd\" -O0 -g -Wall -Werror -DSTANDALONE -I../mDNSCore -I/usr/local/include -I. -I../mDNSMacOSX/Private $(INCLUDEDIRS) -I../DSO -MMD -MF .depfile-${notdir $@} -DNOT_HAVE_SA_LEN -DUSE_SELECT -DUSE_INOTIFY -DGENKEY_PROGRAM=$(GENKEY) -DCERTWRITE_PROGRAM=$(CERTWRITE) -DLINUX -DSRP_CRYPTO_MBEDTLS -DPOSIX_BUILD -DMDNS_NO_STRICT
+# -DSRP_FEATURE_REPLICATION=0: as of mDNSResponder-2881.120.11, srp-replication.c uses symbols that are not
+# in the open-source tree (thread_device_network_state_changed, srpl_is_in_routine_state, ...). Local build
+# patch, see main/tests/README.md (mDNSResponder section).
+SRPCFLAGS = -DMDNS_UDS_SERVERPATH=\"/var/run/mdnsd\" -O0 -g -Wall -Werror -DSTANDALONE -I../mDNSCore -I/usr/local/include -I. -I../mDNSMacOSX/Private $(INCLUDEDIRS) -I../DSO -MMD -MF .depfile-${notdir $@} -DNOT_HAVE_SA_LEN -DUSE_SELECT -DUSE_INOTIFY -DGENKEY_PROGRAM=$(GENKEY) -DCERTWRITE_PROGRAM=$(CERTWRITE) -DLINUX -DSRP_CRYPTO_MBEDTLS -DPOSIX_BUILD -DMDNS_NO_STRICT -DSRP_FEATURE_REPLICATION=0
 #SRPLDOPTS = /usr/local/lib/libmbedtls.a /usr/local/lib/libmbedx509.a /usr/local/lib/libmbedcrypto.a -lbsd
 SRPLDOPTS = -lmbedcrypto -lmbedtls -lmbedx509
 HMACOBJS     = $(OBJDIR)/hmac-mbedtls.o
@@ -97,7 +113,10 @@ clean:
 
 SIMPLEOBJS   = $(OBJDIR)/towire.o $(SIGNOBJS) $(OBJDIR)/srp-log.o
 DSOOBJS      = $(OBJDIR)/dso.o $(OBJDIR)/dso-utils.o
-MDNSOBJS     = $(OBJDIR)/dnssd_clientstub.o $(OBJDIR)/dnssd_ipc.o $(OBJDIR)/dnssd_clientlib.o
+# srp-clientstub.c #includes ../mDNSShared/dnssd_clientstub.c and adds the two functions srp-dnssd.h
+# needs, so it replaces dnssd_clientstub.o here. Local build patch (mDNSResponder-2881.120.11), see
+# main/tests/README.md (mDNSResponder section).
+MDNSOBJS     = $(OBJDIR)/srp-clientstub.o $(OBJDIR)/dnssd_ipc.o $(OBJDIR)/dnssd_clientlib.o
 FROMWIREOBJS = $(OBJDIR)/fromwire.o $(VERIFYOBJS) $(OBJDIR)/wireutils.o
 CFOBJS       = $(OBJDIR)/config-parse.o
 $(BUILDDIR)/dnssd-relay:  $(OBJDIR)/dnssd-relay.o $(DSOOBJS) $(IOOBJS) $(CFOBJS)
@@ -124,6 +143,9 @@ $(OBJDIR)/dso.o:	../DSO/dso.c
 $(OBJDIR)/dnssd_clientstub.o:  ../mDNSShared/dnssd_clientstub.c
 	$(CC) -o $@ $(SRPCFLAGS) $(CFLAGS) -c -I. $(INCLUDEDIRS) $<
 
+$(OBJDIR)/srp-clientstub.o:  srp-clientstub.c ../mDNSShared/dnssd_clientstub.c
+	$(CC) -o $@ $(SRPCFLAGS) $(CFLAGS) -c -I. $(INCLUDEDIRS) $<
+
 $(OBJDIR)/dnssd_clientlib.o:  ../mDNSShared/dnssd_clientlib.c
 	$(CC) -o $@ $(SRPCFLAGS) $(CFLAGS) -c -I. $(INCLUDEDIRS) $<
 
diff --git a/ServiceRegistration/ioloop.c b/ServiceRegistration/ioloop.c
index 30ec734..ebe9ae0 100644
--- a/ServiceRegistration/ioloop.c
+++ b/ServiceRegistration/ioloop.c
@@ -1223,6 +1223,14 @@ ioloop_listener_create(bool stream, bool tls, bool inetd, uint16_t *UNUSED avoid
         listener->address = *ip_address;
     }
     listener->address.sa.sa_family = real_family;
+#ifndef NOT_HAVE_SA_LEN
+    // Local build patch (mDNSResponder-2881.120.11): with no address given, nothing set sa_len, so on platforms that
+    // have it (macOS) bind() below got length 0 and failed with EINVAL, and srp-mdns-proxy had no SRP listener. See
+    // main/tests/README.md (mDNSResponder section).
+    if (ip_address == NULL) {
+        listener->address.sa.sa_len = real_family == AF_INET ? sizeof(listener->address.sin) : sizeof(listener->address.sin6);
+    }
+#endif
 
     if (multicast != 0) {
         if (stream) {
diff --git a/ServiceRegistration/srp-dnssd.h b/ServiceRegistration/srp-dnssd.h
index 53aed1d..d455dd3 100644
--- a/ServiceRegistration/srp-dnssd.h
+++ b/ServiceRegistration/srp-dnssd.h
@@ -76,6 +76,11 @@ void dns_service_record_set_callback(srp_server_t UNUSED *NULLABLE srp_server, D
 bool dns_service_record_validate(srp_server_t UNUSED *NULLABLE srp_server, DNSServiceRef NONNULL sdref,
                                  DNSRecordRef NONNULL rref);
 #else
+// srp-clientstub.h declares DNSServiceRecordValidate/DNSServiceRecordSetCallback, which the two macros at
+// the end of this block call. As of mDNSResponder-2881.120.11 nothing in the open-source tree includes it,
+// so a POSIX build of srp-mdns-proxy fails on implicit declarations. Local build patch, see
+// main/tests/README.md (mDNSResponder section).
+#include "srp-clientstub.h"
 #define dns_service_ref_deallocate(srp_server, ...)      DNSServiceRefDeallocate(__VA_ARGS__)
 #define dns_service_register_record(srp_server, ...)     DNSServiceRegisterRecord(__VA_ARGS__)
 #define dns_service_register_record_wa(srp_server, ...)  DNSServiceRegisterRecordWithAttribute(__VA_ARGS__)
diff --git a/ServiceRegistration/srp-log.c b/ServiceRegistration/srp-log.c
index 2b870d2..9ea448a 100644
--- a/ServiceRegistration/srp-log.c
+++ b/ServiceRegistration/srp-log.c
@@ -176,6 +176,27 @@ srp_log_timestamp(char *buf, size_t bufsize)
 }
 #endif
 
+// srp_log_ref_check / srp_log_ref_final: declared in srp.h (next to the RELEASE_BASE /
+// RETAIN_HERE_LOG family of macros) and called directly by srp-mdns-proxy.c's object
+// finalizers, but never defined anywhere in this open-source snapshot
+// (mDNSResponder-2881.0.25, still so in 2881.120.11) -- linking srp-mdns-proxy fails without them. Minimal stubs
+// added here purely to unblock a local build for use as an SRP wire-protocol interop
+// reference (see main/tests/README.md, mDNSResponder section); not otherwise part
+// of our SRP work. srp_log_ref_check gates a fault-check in RELEASE_BASE and must return
+// true for normal (non-faulted) operation; srp_log_ref_final is a debug-logging hook only.
+bool
+srp_log_ref_check(void *x, const char *object_type, const char *file, int line, bool fault)
+{
+    (void)x; (void)object_type; (void)file; (void)line; (void)fault;
+    return true;
+}
+
+void
+srp_log_ref_final(void *x, unsigned ref_count, const char *object_type, const char *file, int line)
+{
+    (void)x; (void)ref_count; (void)object_type; (void)file; (void)line;
+}
+
