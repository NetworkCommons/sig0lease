diff --git a/ServiceRegistration/srp-dnssd.h b/ServiceRegistration/srp-dnssd.h
index 53aed1d..d455dd3 100644
--- a/ServiceRegistration/srp-dnssd.h
+++ b/ServiceRegistration/srp-dnssd.h
@@ -76,6 +76,11 @@ void dns_service_record_set_callback(srp_server_t UNUSED *NULLABLE srp_server, D
 bool dns_service_record_validate(srp_server_t UNUSED *NULLABLE srp_server, DNSServiceRef NONNULL sdref,
                                  DNSRecordRef NONNULL rref);
 #else
+// srp-clientstub.h declares DNSServiceRecordValidate/DNSServiceRecordSetCallback, which the two macros at
+// the end of this block call. As of mDNSResponder-2881.120.11 nothing in the open-source tree includes it,
+// so a POSIX build of srp-mdns-proxy fails on implicit declarations. Local build patch, see
+// main/tests/README.md (mDNSResponder section).
+#include "srp-clientstub.h"
 #define dns_service_ref_deallocate(srp_server, ...)      DNSServiceRefDeallocate(__VA_ARGS__)
 #define dns_service_register_record(srp_server, ...)     DNSServiceRegisterRecord(__VA_ARGS__)
 #define dns_service_register_record_wa(srp_server, ...)  DNSServiceRegisterRecordWithAttribute(__VA_ARGS__)
diff --git a/ServiceRegistration/srp-log.c b/ServiceRegistration/srp-log.c
index 2b870d2..9ea448a 100644
--- a/ServiceRegistration/srp-log.c
+++ b/ServiceRegistration/srp-log.c
@@ -176,6 +176,27 @@ srp_log_timestamp(char *buf, size_t bufsize)
 }
 #endif
 
+// srp_log_ref_check / srp_log_ref_final: declared in srp.h (next to the RELEASE_BASE /
+// RETAIN_HERE_LOG family of macros) and called directly by srp-mdns-proxy.c's object
+// finalizers, but never defined anywhere in this open-source snapshot
+// (mDNSResponder-2881.0.25, still so in 2881.120.11) -- linking srp-mdns-proxy fails without them. Minimal stubs
+// added here purely to unblock a local build for use as an SRP wire-protocol interop
+// reference (see main/tests/README.md, mDNSResponder section); not otherwise part
+// of our SRP work. srp_log_ref_check gates a fault-check in RELEASE_BASE and must return
+// true for normal (non-faulted) operation; srp_log_ref_final is a debug-logging hook only.
+bool
+srp_log_ref_check(void *x, const char *object_type, const char *file, int line, bool fault)
+{
+    (void)x; (void)object_type; (void)file; (void)line; (void)fault;
+    return true;
+}
+
+void
+srp_log_ref_final(void *x, unsigned ref_count, const char *object_type, const char *file, int line)
+{
+    (void)x; (void)ref_count; (void)object_type; (void)file; (void)line;
+}
+
