 // mode: C
 // tab-width: 4
diff --git a/ServiceRegistration/srp.h b/ServiceRegistration/srp.h
index 93dccad..3b98070 100644
--- a/ServiceRegistration/srp.h
+++ b/ServiceRegistration/srp.h
@@ -197,7 +197,10 @@ void srp_log_ref_final(void *x, unsigned ref_count, const char *object_type, con
 #define SRP_OBJ_REF_COUNT_LIMIT    10000
 
 #ifdef __clang__
-#define FILE_TRIM(x) (strrchr(x, '/') + 1)
+// Local build patch (mDNSResponder-2881.120.11): a file name without '/' (a Makefile build compiles "ioloop.c",
+// not a path) made this strrchr(...) + 1, an invalid pointer that crashed srp-mdns-proxy at its first ALLOC log
+// line on macOS. See main/tests/README.md (mDNSResponder section).
+#define FILE_TRIM(x) (strrchr(x, '/') != NULL ? strrchr(x, '/') + 1 : (x))
 #else
 #define FILE_TRIM(x) (x)
 #endif
