# {{ ansible_managed }}: deploy/ansible, roles/community (deploy/README.md, "The IPFS community node").
# The agent of the {{ registrar_instance }} instance's IPFS community node: {{ community_site }} gives
# the node's addresses and a folder of the folders of the community's members, the instances of
# _ipfs-member._tcp under the subtype {{ community_settings.site }} in {{ community_srp_zone }}
# (docs/sig0lease-agent.md, "A name's IPFS node"). It keeps its names when it stops, for a
# restart.
keystore: {{ community_agent_keystore }}
registrars:
  - protocol: rfc9664
    server: 127.0.0.1:{{ registrar_settings.port }}
    lease: 10m
    on_stop: keep
    names:
      - name: {{ community_site }}
        ipfs:
          api: "http://{{ community_settings.api_address }}"
          swarm_key: {{ community_agent_swarm_key }}
          follow: {type: ipfs-member, domain: {{ community_srp_zone }}, revoke_after: {{ community_settings.revoke_after }}}
