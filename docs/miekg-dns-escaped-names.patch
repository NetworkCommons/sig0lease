+func TestNameEscapes(t *testing.T) {
+	testcases := []struct {
+		in   string
+		wire []byte // nil: an error is expected
+	}{
+		{`a\.b.nl.`, []byte{3, 'a', '.', 'b', 2, 'n', 'l', 0}},
+		{`a\\.nl.`, []byte{2, 'a', '\\', 2, 'n', 'l', 0}},
+		{`a\\\.b.`, []byte{4, 'a', '\\', '.', 'b', 0}},
+		{`\065b.`, []byte{2, 'A', 'b', 0}},
+		{`a\046b.`, []byte{3, 'a', '.', 'b', 0}},
+		{`\x.`, []byte{1, 'x', 0}},
+		{`a\.`, nil},                          // the final dot is escaped: not fully qualified
+		{`\..`, []byte{1, '.', 0}},            // a label that is just a dot
+		{strings.Repeat(`\.`, 64) + `.`, nil}, // 64 octets once unescaped: too long for a label
+	}
+	for i, tc := range testcases {
+		t.Run(fmt.Sprintf("test %d", i), func(t *testing.T) {
+			buf := make([]byte, 256)
+			off, err := Name(tc.in, buf, 0, nil, false)
+			if tc.wire == nil {
+				if err == nil {
+					t.Fatalf("Name(%q) packed %v, expected an error", tc.in, buf[:off])
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Name(%q): %v", tc.in, err)
+			}
+			if !bytes.Equal(buf[:off], tc.wire) {
+				t.Fatalf("Name(%q) = %v, expected %v", tc.in, buf[:off], tc.wire)
+			}
+		})
+	}
+
+	// A 63-octet label written with escapes packs as one label of dots.
+	for _, in := range []string{strings.Repeat(`\.`, 63) + `.`, strings.Repeat(`\046`, 63) + `.`} {
+		buf := make([]byte, 256)
+		off, err := Name(in, buf, 0, nil, false)
+		if err != nil {
+			t.Fatalf("Name(%q): %v", in, err)
+		}
+		want := append(append([]byte{63}, bytes.Repeat([]byte{'.'}, 63)...), 0)
+		if !bytes.Equal(buf[:off], want) {
+			t.Fatalf("Name(%q) = %v, expected %v", in, buf[:off], want)
+		}
+	}
+}
