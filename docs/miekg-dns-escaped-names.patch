+// labelEnd returns the index of the unescaped dot that ends the label starting at s[begin], or len(s) if
+// there is none, and how many octets the escapes in the label save: 1 for each "\X", 3 for each "\DDD".
+func labelEnd(s string, begin int) (i, escapes int) {
+	for i = begin; i < len(s); i++ {
+		switch s[i] {
+		case '.':
+			return i, escapes
+		case '\\':
+			if ddd.Is(s[i+1:]) {
+				i += 3
+				escapes += 3
+			} else {
+				i++
+				escapes++
+			}
+		}
+	}
+	return len(s), escapes
+}
+
+// unescapeLabel copies label to dst, replacing "\X" by X and "\DDD" by the octet DDD.
+func unescapeLabel(dst []byte, label string) {
+	j := 0
+	for i := 0; i < len(label); i++ {
+		b := label[i]
+		if b == '\\' && i+1 < len(label) {
+			if ddd.Is(label[i+1:]) {
+				b = ddd.ToByte(label[i+1:])
+				i += 3
+			} else {
+				i++
+				b = label[i]
+			}
+		}
+		dst[j] = b
+		j++
+	}
+}
+
+// isEscaped reports whether s[i] is escaped: preceded by an odd number of backslashes.
+func isEscaped(s string, i int) bool {
+	n := 0
+	for i--; i >= 0 && s[i] == '\\'; i-- {
+		n++
+	}
+	return n%2 == 1
+}
+
