+	m1 := &dns.Msg{Data: m.Data}
+	if err := m1.Unpack(); err != nil {
+		t.Fatal(err)
+	}
+	if got := m1.Answer[0].Header().Name; got != instance {
+		t.Errorf("expected SRV owner %s, got %s", instance, got)
+	}
+	if got := m1.Answer[1].(*dns.PTR).Ptr; got != instance {
+		t.Errorf("expected PTR target %s, got %s", instance, got)
+	}
+}
