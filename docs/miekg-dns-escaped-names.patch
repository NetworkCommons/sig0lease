+// (RFC 6763 section 4.1.1), survives packing and unpacking as one label: as an owner name, in RDATA, and
+// compressed.
+func TestMsgEscapedNames(t *testing.T) {
+	const instance = `Printer v2\.1._ipp._tcp.example.`
+
+	srv := new(dns.SRV)
+	srv.Hdr = dns.Header{Name: instance, Class: dns.ClassINET, TTL: 3600}
+	srv.Port = 631
+	srv.Target = "host.example."
+	ptr := new(dns.PTR)
+	ptr.Hdr = dns.Header{Name: "_ipp._tcp.example.", Class: dns.ClassINET, TTL: 3600}
+	ptr.Ptr = instance // packed as a compression pointer to the SRV owner name
+
+	m := dns.NewMsg("example.", dns.TypeSOA)
+	m.Answer = []dns.RR{srv, ptr}
+	if err := m.Pack(); err != nil {
+		t.Fatal(err)
+	}
+	label := append([]byte{12}, "Printer v2.1"...)
+	if bytes.Count(m.Data, label) != 1 {
+		t.Fatalf("expected the single label %q once in the packed message, got %q", label, m.Data)
+	}
